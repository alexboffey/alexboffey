---
/**
 * The scene mount.
 *
 * The canvas persists across route changes, so scroll and camera position carry
 * over and navigation reads as travel through one field rather than a page
 * swap. Everything visible here has a CSS ground underneath it, so a client
 * with no WebGL2 still gets the world's colour and depth, just held still.
 */
---

<div class="lattice" aria-hidden="true" transition:persist="lattice">
  <canvas class="lattice__canvas" data-lattice></canvas>
  <div class="lattice__scrim"></div>
</div>

<style>
  .lattice {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    /* The fallback ground: the same three values the shader uses, so a client
       without WebGL2 gets atmosphere rather than a flat fill. */
    background:
      radial-gradient(
        120% 90% at 82% 8%,
        color-mix(in oklab, var(--echo) 85%, transparent) 0%,
        transparent 58%
      ),
      radial-gradient(
        90% 70% at 12% 96%,
        color-mix(in oklab, var(--incandescent) 12%, transparent) 0%,
        transparent 62%
      ),
      var(--void);
  }

  .lattice__canvas {
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity var(--dur-enter) var(--ease);
  }

  .lattice__canvas[data-live="true"] {
    opacity: 1;
  }

  /**
   * Holds contrast for text over the field. Two gradients, not one: the
   * vertical pass keeps the nav and the baseline legible, and the horizontal
   * pass gives the text column its own ground, because every page sets its
   * content against the left edge.
   */
  .lattice__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to right,
        color-mix(in oklab, var(--void) 86%, transparent) 0%,
        color-mix(in oklab, var(--void) 66%, transparent) 30%,
        color-mix(in oklab, var(--void) 22%, transparent) 68%,
        transparent 100%
      ),
      linear-gradient(
        to bottom,
        color-mix(in oklab, var(--void) 62%, transparent) 0%,
        color-mix(in oklab, var(--void) 22%, transparent) 30%,
        color-mix(in oklab, var(--void) 52%, transparent) 100%
      );
  }

  /**
   * Narrow screens put content across the full width, so the horizontal pass
   * has nothing to protect and the field sits directly behind body copy. Damp
   * it flat instead; legibility on a phone outranks the atmosphere.
   */
  @media (max-width: 1180px) {
    .lattice__scrim {
      background:
        linear-gradient(
          to bottom,
          color-mix(in oklab, var(--void) 74%, transparent) 0%,
          color-mix(in oklab, var(--void) 62%, transparent) 30%,
          color-mix(in oklab, var(--void) 74%, transparent) 100%
        ),
        color-mix(in oklab, var(--void) 30%, transparent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lattice__canvas {
      transition: none;
    }
  }
</style>

<script>
  import { mountLattice } from "../scripts/lattice"

  function boot() {
    const canvas = document.querySelector<HTMLCanvasElement>("[data-lattice]")
    if (canvas) mountLattice(canvas)
  }

  boot()
  document.addEventListener("astro:after-swap", boot)
</script>
