---
import Mark from "./Mark.astro"

/**
 * Thin corner links, per the world's own topology. No pill nav, no underline
 * bar: the active route is marked with the same isometric diamond the lattice
 * uses for a hot block.
 */
const { path } = Astro.props as { path: string }

const links = [{ href: "/about/", label: "About" }]

const isActive = (href: string) => path === href || path.startsWith(href)
const contactHref = path === "/" ? "#contact" : "/#contact"

const now = new Date()
const stamp = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}-${String(now.getDate()).padStart(2, "0")}-${String(now.getHours()).padStart(2, "0")}${String(now.getMinutes()).padStart(2, "0")}`
const cvDownloadName = `alex-boffey-cv-${stamp}.pdf`

import styles from "./Nav.module.css"
---

<header class={styles.nav}>
  <a class={styles.nav__brand} href="/" aria-label="Alex Boffey, home">
    <Mark size={26} />
    <span class={styles.nav__wordmark}>Alex Boffey</span>
  </a>

  <nav class={styles.nav__links} aria-label="Main">
    {
      links.map((link) => (
        <a
          class:list={[
            styles.nav__link,
            { [styles["is-active"]]: isActive(link.href) },
          ]}
          href={link.href}
          aria-current={isActive(link.href) ? "page" : undefined}
        >
          {link.label}
        </a>
      ))
    }
    <a
      class:list={[styles.nav__link, styles["nav__link--action"]]}
      href={contactHref}>Contact</a
    >
    <a
      class:list={[styles.nav__link, styles["nav__link--action"]]}
      href="/alex-boffey-cv.pdf"
      download={cvDownloadName}>Download CV</a
    >
  </nav>
</header>
