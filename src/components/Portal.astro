---
import { site } from "../lib/site"

/**
 * The first viewport.
 *
 * The name at monument scale is the memory device; the positioning sits
 * immediately under it in flowing text because a hiring manager has to be able
 * to place him in one read, and the world's oversized single word on its own
 * would not do that. The width axis of the display face does the work an extra
 * font weight would otherwise be shipped for.
 */
import styles from "./Portal.module.css"
---

<section class={styles.portal} aria-labelledby="portal-name">
  <div class:list={["shell", styles.portal__inner]}>
    <h1 class={styles.portal__name} id="portal-name">
      <span class={styles.portal__given}>Alex</span>
      <span class={styles.portal__surname}>{site.surname}</span>
    </h1>

    <div class={styles.portal__body}>
      <p class={styles.portal__positioning}>
        <strong>Full stack</strong> software engineer. The depth is <strong
          >client-side architecture</strong
        >: state, caching, data orchestration, build and release. <strong
          >Backend services</strong
        >, infrastructure and databases are part of the same job.
      </p>

      <div class={styles.portal__actions}>
        <a class="action action--primary" href="/cv/">Read the CV</a>
        <a class="action" href={`mailto:${site.email}`}>Email me</a>
      </div>
    </div>

    <p class={styles.portal__status}>
      <span class={styles.portal__pip}></span>
      {site.role} at {site.employer}
      <span class={styles.portal__sep}>/</span>
      {site.location}
    </p>
  </div>

  <div class={styles.portal__cue} aria-hidden="true">
    <span class={styles["portal__cue-line"]}></span>
  </div>
</section>
