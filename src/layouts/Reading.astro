---
import Root from "./Root.astro"

/**
 * Read mode.
 *
 * A post reached cold from a search result has one job: be readable. The field
 * is damped (see `quiet` on Root), the measure takes over, and the world shows
 * up as the hairline head rule, the display face on the title, and the accent on
 * links rather than as anything that moves while you are reading.
 */
interface Props {
  title: string
  description: string
  eyebrow: string
  meta: string[]
  backHref: string
  backLabel: string
}

const { title, description, eyebrow, meta, backHref, backLabel } = Astro.props
---

<Root title={title} description={description} quiet scene="reading">
  <article class="read shell">
    <header class="read__head">
      <a class="read__back" href={backHref}>
        <span class="read__back-mark" aria-hidden="true"></span>
        {backLabel}
      </a>

      <h1 class="read__title">{title}</h1>

      {description && <p class="read__standfirst">{description}</p>}

      <dl class="read__meta">
        <dt class="visually-hidden">Section</dt>
        <dd class="read__metaitem">{eyebrow}</dd>
        {
          meta.map((item) => (
            <>
              <dt class="visually-hidden">Detail</dt>
              <dd class="read__metaitem">{item}</dd>
            </>
          ))
        }
      </dl>
    </header>

    <div class="prose read__body">
      <slot />
    </div>

    <footer class="read__foot">
      <a class="action" href={backHref}>{backLabel}</a>
    </footer>
  </article>
</Root>

<style>
  .read {
    padding-block: var(--space-2xl) var(--space-3xl);
  }

  .read__head {
    display: grid;
    gap: var(--space-md);
    max-width: var(--measure);
    padding-bottom: var(--space-lg);
    margin-bottom: var(--space-xl);
    border-bottom: 1px solid var(--rule);
  }

  .read__back {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    justify-self: start;
    font-family: var(--font-display);
    font-size: var(--size-label);
    font-stretch: 88%;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text-label);
  }

  .read__back:hover,
  .read__back:focus-visible {
    color: var(--incandescent);
  }

  .read__back-mark {
    width: 5px;
    height: 5px;
    border: 1px solid currentColor;
    transform: rotate(45deg);
    transition: transform var(--dur) var(--ease);
  }

  .read__back:hover .read__back-mark {
    transform: rotate(45deg) translate(-2px, 2px);
  }

  .read__title {
    font-size: var(--size-display);
    font-stretch: 88%;
    font-weight: 600;
    line-height: 1.04;
    color: var(--paper);
  }

  .read__standfirst {
    font-size: var(--size-lead);
    line-height: 1.45;
    color: var(--text-secondary);
  }

  .read__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    margin: 0;
  }

  .read__metaitem {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--size-micro);
    font-stretch: 88%;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-label);
  }

  .read__metaitem:not(:last-child)::after {
    content: "";
    display: inline-block;
    width: 3px;
    height: 3px;
    margin-left: var(--space-md);
    vertical-align: 0.2em;
    background: var(--glimmer);
    transform: rotate(45deg);
  }

  .read__body {
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .read__foot {
    max-width: var(--measure);
    padding-top: var(--space-lg);
    margin-top: var(--space-2xl);
    border-top: 1px solid var(--rule);
  }
</style>
