---
import Root from "../layouts/Root.astro"
---

<Root
  scene="lost"
  title="Not found"
  description="That page does not exist on alexboffey.co.uk."
>
  <section class="lost shell">
    <p class="lost__code">404</p>
    <h1 class="lost__title">No block at those coordinates</h1>
    <p class="lead">
      The page you asked for is not here. Everything else still is.
    </p>
    <div class="lost__actions">
      <a class="action action--primary" href="/">Back to the start</a>
      <a class="action" href="/writing/">Read something instead</a>
    </div>
  </section>
</Root>

<style>
  .lost {
    display: grid;
    gap: var(--space-md);
    align-content: center;
    min-height: 72svh;
    padding-block: var(--space-2xl);
  }

  .lost__code {
    font-family: var(--font-display);
    font-size: var(--size-monument);
    font-stretch: 72%;
    font-weight: 700;
    line-height: 0.82;
    letter-spacing: var(--track-monument);
    color: var(--incandescent);
  }

  .lost__title {
    font-size: var(--size-title);
    font-stretch: 88%;
    color: var(--paper);
  }

  .lost__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-md);
    margin-top: var(--space-sm);
  }
</style>
