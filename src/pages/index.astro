---
import { education, interests, positions, profile } from "../lib/cv"
import { site, social, strands } from "../lib/site"
import Root from "../layouts/Root.astro"

/**
 * The home page is the CV. A visitor who follows the link in the PDF should
 * land on the same information in the same shape: name, tagline, summary,
 * strands, roles. The lattice behind it is brand mood, not the stage.
 */

const now = new Date()
const stamp = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}-${String(now.getDate()).padStart(2, "0")}-${String(now.getHours()).padStart(2, "0")}${String(now.getMinutes()).padStart(2, "0")}`
const cvDownloadName = `alex-boffey-cv-${stamp}.pdf`
---

<Root
  title={site.positioning}
  description={site.description}
  scene="about"
  quiet
>
  <div class="cv shell">
    <header class="cv__head recede">
      <p class="cv__name rise">{site.name}</p>
      <h1 class="cv__title rise" style="--i: 1">
        Product engineer,<br />
        <span class="cv__accent">with deep frontend roots</span>
      </h1>

      <p class="lead cv__profile rise" style="--i: 2">{profile}</p>
    </header>

    <section class="cv__section" aria-labelledby="cv-strands">
      <h2 class="cv__heading reveal" id="cv-strands">What I do</h2>
      <dl class="strands">
        {
          strands.map((strand) => (
            <div class="strands__row reveal">
              <dt class="strands__name">{strand.name}</dt>
              <dd class="strands__body">{strand.summary}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="cv__section" aria-labelledby="cv-experience">
      <h2 class="cv__heading reveal" id="cv-experience">Experience</h2>

      <ol class="roles">
        {
          positions.map((position) => (
            <li class="role reveal">
              <details class="role__box" open>
                <summary class="role__summary">
                  <span class="role__mark" aria-hidden="true" />
                  <span class="role__ident">
                    <span class="role__org">{position.org}</span>
                    <span class="role__meta">
                      {position.location} &middot; {position.span}
                    </span>
                  </span>
                  <span class="role__titles">
                    {position.roles.map((role) => (
                      <span class="role__title">
                        <span class="role__title-name">{role.title}</span>
                        <span class="role__title-span">{role.span}</span>
                      </span>
                    ))}
                  </span>
                </summary>

                <div class="role__body">
                  {position.context && (
                    <p class="role__context">{position.context}</p>
                  )}
                  {position.groups.map((group) => (
                    <div class="role__group">
                      {group.heading && (
                        <h4 class="role__group-heading label">
                          {group.heading}
                        </h4>
                      )}
                      <ul class="role__bullets">
                        {group.bullets.map((bullet) => (
                          <li class="role__bullet">{bullet.text}</li>
                        ))}
                      </ul>
                    </div>
                  ))}

                  <div class="role__stack">
                    <h4 class="role__stack-label label">Used here</h4>
                    <ul class="role__stack-items">
                      {position.stack.map((item) => (
                        <li class="skill">{item}</li>
                      ))}
                    </ul>
                  </div>
                </div>
              </details>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="cv__section cv__section--split reveal-children">
      <div>
        <h2 class="cv__heading" id="cv-education">Education</h2>
        <p class="cv__plain">
          <strong>{education.institution}</strong><br />
          {education.award}<br />
          <span class="cv__span">{education.span}</span>
        </p>
      </div>
      <div>
        <h2 class="cv__heading" id="cv-interests">Interests</h2>
        <p class="cv__plain">{interests}</p>
      </div>
    </section>

    <footer class="cv__foot reveal" id="contact">
      <a class="action action--primary" href={`mailto:${site.email}`}>
        Email me
      </a>
      <a class="action" href="/alex-boffey-cv.pdf" download={cvDownloadName}
        >Download CV</a
      >
      <a class="action" href={social.linkedin} rel="me noopener">LinkedIn</a>
      <a class="action" href={social.github} rel="me noopener">GitHub</a>
    </footer>
  </div>
</Root>

<style>
  .cv {
    padding-block: var(--space-2xl) var(--space-3xl);
  }

  .cv__head {
    display: grid;
    gap: var(--space-md);
  }

  .cv__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--size-label);
    font-stretch: 88%;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-label);
  }

  .cv__title {
    position: relative;
    font-size: var(--size-display);
    font-stretch: var(--wdth-display);
    font-weight: 700;
    line-height: 0.96;
    color: var(--paper);
  }

  .cv__accent {
    color: var(--incandescent);
  }

  .cv__profile {
    margin: 0;
    max-width: 68ch;
    color: var(--text-secondary);
  }

  .strands {
    display: grid;
    gap: var(--space-lg);
    margin: 0;
    padding: 0;
    max-width: 78ch;
  }

  .strands__row {
    display: grid;
    gap: var(--space-xs);
    opacity: 1;
  }

  .strands__name {
    font-family: var(--font-display);
    font-size: var(--size-label);
    font-stretch: 88%;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--incandescent);
  }

  .strands__body {
    margin: 0;
    color: var(--text-secondary);
    max-width: 72ch;
  }

  .cv__section {
    margin-top: var(--space-2xl);
  }

  .cv__section--split {
    display: grid;
    gap: var(--space-xl);
  }

  @media (min-width: 46rem) {
    .cv__section--split {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-2xl);
    }
  }

  .cv__heading {
    margin-bottom: var(--space-lg);
    font-size: var(--size-title);
    font-stretch: 86%;
    color: var(--paper);
  }

  .cv__plain {
    max-width: 54ch;
    color: var(--text-secondary);
  }

  .cv__plain strong {
    color: var(--paper);
    font-weight: 600;
  }

  .cv__span {
    color: var(--text-label);
  }

  .roles {
    display: grid;
    gap: 0;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .role {
    border-bottom: 1px solid var(--rule);
  }

  /* One indent for the whole role: the mark sits in its own column and the
     org, the title ladder and the body all hang off the same left edge. */
  .role {
    --role-gap: var(--space-md);
    --role-indent: calc(7px + var(--role-gap));
  }

  @media (min-width: 52rem) {
    .role {
      --role-gap: var(--space-lg);
    }
  }

  .role__summary {
    display: grid;
    grid-template-columns: 7px minmax(0, 1fr);
    gap: var(--space-sm) var(--role-gap);
    padding-block: var(--space-lg);
    cursor: pointer;
    list-style: none;
  }

  .role__summary::-webkit-details-marker {
    display: none;
  }

  .role__summary:hover .role__org,
  .role__summary:focus-visible .role__org {
    color: var(--ember);
  }

  .role__mark {
    width: 7px;
    height: 7px;
    margin-top: 0.7em;
    border: 1px solid var(--incandescent);
    transform: rotate(45deg);
    transition: transform var(--dur) var(--ease);
  }

  /* Progressive: browsers without ::details-content or interpolate-size snap
     open and shut, as before. */
  @media (prefers-reduced-motion: no-preference) {
    .role__box {
      interpolate-size: allow-keywords;
    }

    .role__box::details-content {
      height: 0;
      overflow: clip;
      opacity: 0;
      transition:
        height var(--dur) var(--ease),
        opacity var(--dur) var(--ease),
        content-visibility var(--dur) allow-discrete;
    }

    .role__box[open]::details-content {
      height: auto;
      opacity: 1;
    }
  }

  details[open] .role__mark {
    background: var(--incandescent);
    transform: rotate(0deg);
  }

  .role__ident {
    display: grid;
    gap: var(--space-2xs);
  }

  .role__org {
    font-family: var(--font-display);
    font-size: var(--size-row-lg);
    font-stretch: 84%;
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: var(--track-tight);
    color: var(--paper);
    transition: color var(--dur-fast) var(--ease);
  }

  .role__meta {
    font-family: var(--font-display);
    font-size: var(--size-micro);
    font-stretch: 88%;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-label);
  }

  /* The promotion ladder, newest first, hanging off the org rather than
     floating in a column of its own. */
  .role__titles {
    grid-column: 2;
    display: grid;
    gap: var(--space-xs);
  }

  .role__title {
    display: grid;
    font-size: var(--size-small);
    color: var(--paper);
  }

  /* Wider: dates line up in their own column beside the longest title. */
  @media (min-width: 34rem) {
    .role__titles {
      grid-template-columns: max-content max-content;
      align-items: baseline;
      gap: var(--space-2xs) var(--space-lg);
    }

    .role__title {
      display: contents;
    }
  }

  .role__title-span {
    font-family: var(--font-display);
    font-size: var(--size-micro);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-label);
  }

  .role__body {
    padding: 0 0 var(--space-lg) var(--role-indent);
    max-width: calc(var(--measure) + var(--role-indent));
  }

  .role__context {
    padding-bottom: var(--space-md);
    margin-bottom: var(--space-md);
    border-bottom: 1px solid var(--rule);
    font-size: var(--size-small);
    color: var(--text-label);
  }

  .role__group + .role__group {
    margin-top: var(--space-lg);
  }

  .role__group-heading {
    margin: 0 0 var(--space-sm);
    color: var(--incandescent);
  }

  .role__bullets {
    display: grid;
    gap: var(--space-sm);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .role__bullet {
    position: relative;
    padding-left: var(--space-md);
    color: var(--text-secondary);
  }

  .role__bullet::before {
    content: "";
    position: absolute;
    top: 0.62em;
    left: 0;
    width: 4px;
    height: 4px;
    border: 1px solid var(--glimmer);
    transform: rotate(45deg);
  }

  .role__stack {
    display: grid;
    gap: var(--space-xs);
    padding-top: var(--space-md);
    margin-top: var(--space-md);
    border-top: 1px solid var(--rule);
  }

  .role__stack-label {
    color: var(--text-label);
  }

  .role__stack-items {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-xs);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .skill {
    padding: 0.25em 0.55em;
    border: 1px solid var(--rule);
    font-size: var(--size-small);
    color: var(--text-secondary);
  }

  .cv__foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-md);
    padding-top: var(--space-lg);
    margin-top: var(--space-2xl);
    border-top: 1px solid var(--rule);
  }

  @media print {
    .cv__foot {
      display: none;
    }

    .cv {
      padding: 0;
      color: var(--print-base);
    }

    .cv__title,
    .cv__heading,
    .role__org,
    .cv__plain strong {
      color: var(--print-ink);
    }

    .cv__summary,
    .role__bullet,
    .cv__plain,
    .skill {
      color: var(--print-text) !important;
      opacity: 1 !important;
    }

    .role__mark,
    .role__bullet::before {
      border-color: var(--print-rule);
      background: none;
    }

    .role {
      break-inside: avoid;
    }

    .skill {
      border-color: var(--print-hairline);
    }
  }
</style>
