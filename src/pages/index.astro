---
import {
  education,
  interests,
  positions,
  profile,
  unattributedStack,
} from "../lib/cv"
import { site, social, strands } from "../lib/site"
import Root from "../layouts/Root.astro"

/**
 * The home page is the CV. A visitor who follows the link in the PDF should
 * land on the same information in the same shape: name, tagline, summary,
 * strands, roles. The lattice behind it is brand mood, not the stage.
 */

const now = new Date()
const stamp = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}-${String(now.getDate()).padStart(2, "0")}-${String(now.getHours()).padStart(2, "0")}${String(now.getMinutes()).padStart(2, "0")}`
const cvDownloadName = `alex-boffey-cv-${stamp}.pdf`
---

<Root
  title={site.positioning}
  description={site.description}
  scene="about"
  quiet
>
  <div class="cv shell">
    <header class="cv__head">
      <p class="cv__name">{site.name}</p>
      <h1 class="cv__title">
        <span class="cv__title-layer cv__title-base">
          Product engineer,<br />
          <span class="cv__accent">with deep frontend roots</span>
        </span>
        <span class="cv__title-layer cv__title-swap" aria-hidden="true">
          Product engineer,<br />
          <span class="cv__accent-swap">with deep frontend roots</span>
        </span>
      </h1>

      <p class="lead cv__profile">{profile}</p>
    </header>

    <section class="cv__section" aria-labelledby="cv-strands">
      <h2 class="cv__heading" id="cv-strands">What I do</h2>
      <dl class="strands">
        {
          strands.map((strand) => (
            <div class="strands__row">
              <dt class="strands__name">{strand.name}</dt>
              <dd class="strands__body">{strand.summary}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="cv__section" aria-labelledby="cv-experience">
      <h2 class="cv__heading" id="cv-experience">Experience</h2>

      <ol class="roles">
        {
          positions.map((position) => (
            <li class="role">
              <details class="role__box" open>
                <summary class="role__summary">
                  <span class="role__mark" aria-hidden="true" />
                  <span class="role__ident">
                    <span class="role__org">{position.org}</span>
                    <span class="role__meta">
                      {position.location} &middot; {position.span}
                    </span>
                  </span>
                  <span class="role__titles">
                    {position.roles.map((role) => (
                      <span class="role__title">
                        {role.title}
                        <span class="role__title-span">{role.span}</span>
                      </span>
                    ))}
                  </span>
                </summary>

                <div class="role__body">
                  {position.context && (
                    <p class="role__context">{position.context}</p>
                  )}
                  {position.groups.map((group) => (
                    <div class="role__group">
                      {group.heading && (
                        <h4 class="role__group-heading label">
                          {group.heading}
                        </h4>
                      )}
                      <ul class="role__bullets">
                        {group.bullets.map((bullet) => (
                          <li class="role__bullet">{bullet.text}</li>
                        ))}
                      </ul>
                    </div>
                  ))}

                  <div class="role__stack">
                    <h4 class="role__stack-label label">Used here</h4>
                    <ul class="role__stack-items">
                      {position.stack.map((item) => (
                        <li class="skill">{item}</li>
                      ))}
                    </ul>
                  </div>
                </div>
              </details>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="cv__section" aria-labelledby="cv-also">
      <h2 class="cv__heading" id="cv-also">Also works with</h2>
      <p class="cv__plain cv__also-note">
        These are real, but the CV does not tie them to a particular job, so
        they sit here rather than under an employer.
      </p>
      <ul class="skillgroup__items">
        {unattributedStack.map((item) => <li class="skill">{item}</li>)}
      </ul>
    </section>

    <section class="cv__section cv__section--split">
      <div>
        <h2 class="cv__heading" id="cv-education">Education</h2>
        <p class="cv__plain">
          <strong>{education.institution}</strong><br />
          {education.award}<br />
          <span class="cv__span">{education.span}</span>
        </p>
      </div>
      <div>
        <h2 class="cv__heading" id="cv-interests">Interests</h2>
        <p class="cv__plain">{interests}</p>
      </div>
    </section>

    <footer class="cv__foot" id="contact">
      <a class="action action--primary" href={`mailto:${site.email}`}>
        Email me
      </a>
      <a class="action" href="/alex-boffey-cv.pdf" download={cvDownloadName}
        >Download CV</a
      >
      <a class="action" href={social.linkedin} rel="me noopener">LinkedIn</a>
      <a class="action" href={social.github} rel="me noopener">GitHub</a>
    </footer>
  </div>
</Root>

<style>
  .cv {
    padding-block: var(--space-2xl) var(--space-3xl);
  }

  .cv__head {
    display: grid;
    gap: var(--space-md);
  }

  .cv__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--size-label);
    font-stretch: 88%;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-label);
  }

  .cv__title {
    position: relative;
    font-size: var(--size-display);
    font-stretch: var(--wdth-display);
    font-weight: 700;
    line-height: 0.96;
    color: var(--paper);
    transition:
      font-stretch 900ms var(--ease),
      opacity 600ms var(--ease);
  }

  @starting-style {
    .cv__title {
      font-stretch: 62%;
      opacity: 0;
    }
  }

  .cv__title:hover {
    animation: title-breathe 3s ease-in-out infinite;
  }

  @keyframes title-breathe {
    0%,
    100% {
      font-stretch: var(--wdth-display);
    }
    50% {
      font-stretch: 94%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cv__title {
      transition: none;
      animation: none;
    }
    .cv__title:hover {
      animation: none;
    }
  }

  .cv__accent {
    color: var(--incandescent);
  }

  .cv__title-layer {
    display: block;
  }

  .cv__title-swap {
    position: absolute;
    inset: 0;
    color: var(--incandescent);
    pointer-events: none;
    --mask-size: 320px;
    -webkit-mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 750 750'><polygon points='487.1,576.7 263.7,706.5 38.9,576.7 262.3,446.9' fill='black'/><polygon points='488.5,309.9 487.7,568.2 262.9,438.4 263.7,180.1' fill='black'/><polygon points='254.3,183.3 255,441.6 30.2,571.4 29.5,313.1' fill='black'/><polygon points='715.8,173.3 492.4,303.1 267.6,173.3 491,43.5' fill='black'/><polygon points='719.8,180.1 720.5,438.4 495.7,568.2 495,309.9' fill='black'/></svg>");
    mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 750 750'><polygon points='487.1,576.7 263.7,706.5 38.9,576.7 262.3,446.9' fill='black'/><polygon points='488.5,309.9 487.7,568.2 262.9,438.4 263.7,180.1' fill='black'/><polygon points='254.3,183.3 255,441.6 30.2,571.4 29.5,313.1' fill='black'/><polygon points='715.8,173.3 492.4,303.1 267.6,173.3 491,43.5' fill='black'/><polygon points='719.8,180.1 720.5,438.4 495.7,568.2 495,309.9' fill='black'/></svg>");
    -webkit-mask-size: var(--mask-size) var(--mask-size);
    mask-size: var(--mask-size) var(--mask-size);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: calc(var(--mx, -600px) - var(--mask-size) / 2)
      calc(var(--my, -600px) - var(--mask-size) / 2);
    mask-position: calc(var(--mx, -600px) - var(--mask-size) / 2)
      calc(var(--my, -600px) - var(--mask-size) / 2);
  }

  .cv__accent-swap {
    color: var(--paper);
  }

  @media (prefers-reduced-motion: reduce) {
    .cv__title-swap {
      display: none;
    }
  }

  .cv__profile {
    margin: 0;
    max-width: 68ch;
    color: var(--text-secondary);
  }

  .strands {
    display: grid;
    gap: var(--space-lg);
    margin: 0;
    padding: 0;
    max-width: 78ch;
  }

  .strands__row {
    display: grid;
    gap: var(--space-xs);
    opacity: 1;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .strands__row {
        animation: strand-rise linear both;
        animation-timeline: view();
        animation-range: entry 10% cover 25%;
      }

      @keyframes strand-rise {
        from {
          opacity: 0;
          transform: translateY(6px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
    }
  }

  .strands__name {
    font-family: var(--font-display);
    font-size: var(--size-label);
    font-stretch: 88%;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--incandescent);
  }

  .strands__body {
    margin: 0;
    color: var(--text-secondary);
    max-width: 72ch;
  }

  .cv__section {
    margin-top: var(--space-2xl);
  }

  .cv__section--split {
    display: grid;
    gap: var(--space-xl);
  }

  @media (min-width: 46rem) {
    .cv__section--split {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-2xl);
    }
  }

  .cv__heading {
    margin-bottom: var(--space-lg);
    font-size: var(--size-title);
    font-stretch: 86%;
    color: var(--paper);
  }

  .cv__plain {
    max-width: 54ch;
    color: var(--text-secondary);
  }

  .cv__plain strong {
    color: var(--paper);
    font-weight: 600;
  }

  .cv__span {
    color: var(--text-label);
  }

  .roles {
    display: grid;
    gap: 0;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .role {
    border-bottom: 1px solid var(--rule);
  }

  .role__summary {
    display: grid;
    gap: var(--space-xs) var(--space-lg);
    padding-block: var(--space-lg);
    cursor: pointer;
    list-style: none;
  }

  .role__summary::-webkit-details-marker {
    display: none;
  }

  .role__summary:hover .role__org,
  .role__summary:focus-visible .role__org {
    color: var(--ember);
  }

  .role__mark {
    width: 7px;
    height: 7px;
    border: 1px solid var(--incandescent);
    transform: rotate(45deg);
    transition: transform var(--dur) var(--ease);
  }

  details[open] .role__mark {
    background: var(--incandescent);
    transform: rotate(0deg);
  }

  .role__ident {
    display: grid;
    gap: var(--space-2xs);
  }

  .role__org {
    font-family: var(--font-display);
    font-size: var(--size-row-lg);
    font-stretch: 84%;
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: var(--track-tight);
    color: var(--paper);
    transition: color var(--dur-fast) var(--ease);
  }

  .role__meta {
    font-family: var(--font-display);
    font-size: var(--size-micro);
    font-stretch: 88%;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-label);
  }

  .role__titles {
    display: grid;
    gap: var(--space-2xs);
    align-content: start;
  }

  .role__title {
    display: grid;
    font-size: var(--size-small);
    color: var(--paper);
  }

  .role__title-span {
    font-family: var(--font-display);
    font-size: var(--size-micro);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-label);
  }

  @media (min-width: 52rem) {
    .role__summary {
      grid-template-columns: auto auto minmax(0, 1fr);
      align-items: start;
    }

    .role__mark {
      margin-top: 0.7em;
    }
  }

  .role__body {
    padding-bottom: var(--space-lg);
    max-width: 78ch;
  }

  @media (min-width: 52rem) {
    .role__body {
      padding-left: calc(7px + var(--space-lg));
    }
  }

  .role__context {
    padding-bottom: var(--space-md);
    margin-bottom: var(--space-md);
    border-bottom: 1px solid var(--rule);
    font-size: var(--size-small);
    color: var(--text-label);
  }

  .role__group + .role__group {
    margin-top: var(--space-lg);
  }

  .role__group-heading {
    margin: 0 0 var(--space-sm);
    color: var(--incandescent);
  }

  .role__bullets {
    display: grid;
    gap: var(--space-sm);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .role__bullet {
    position: relative;
    padding-left: var(--space-md);
    color: var(--text-secondary);
  }

  .role__bullet::before {
    content: "";
    position: absolute;
    top: 0.62em;
    left: 0;
    width: 4px;
    height: 4px;
    border: 1px solid var(--glimmer);
    transform: rotate(45deg);
  }

  .role__stack {
    display: grid;
    gap: var(--space-xs);
    padding-top: var(--space-md);
    margin-top: var(--space-md);
    border-top: 1px solid var(--rule);
  }

  .role__stack-label {
    color: var(--text-label);
  }

  .role__stack-items {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-xs);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .cv__also-note {
    margin-bottom: var(--space-md);
    font-size: var(--size-small);
    color: var(--text-label);
  }

  .skillgroup__items {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-xs);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .skill {
    padding: 0.25em 0.55em;
    border: 1px solid var(--rule);
    font-size: var(--size-small);
    color: var(--text-secondary);
  }

  .cv__foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-md);
    padding-top: var(--space-lg);
    margin-top: var(--space-2xl);
    border-top: 1px solid var(--rule);
  }

  @media print {
    .cv__foot {
      display: none;
    }

    .cv__title-swap {
      display: none;
    }

    .cv {
      padding: 0;
      color: var(--print-base);
    }

    .cv__title,
    .cv__heading,
    .role__org,
    .cv__plain strong {
      color: var(--print-ink);
    }

    .cv__summary,
    .role__bullet,
    .cv__plain,
    .skill {
      color: var(--print-text) !important;
      opacity: 1 !important;
    }

    .role__mark,
    .role__bullet::before {
      border-color: var(--print-rule);
      background: none;
    }

    .role {
      break-inside: avoid;
    }

    .skill {
      border-color: var(--print-hairline);
    }
  }
</style>

<script>
  // Cursor-follow colour swap on the home hero. Two layered copies of the
  // title: base is the normal palette, swap sits on top with the colours
  // inverted and a circular mask around the pointer.
  const title = document.querySelector<HTMLElement>(".cv__title")
  if (title && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const update = (event: PointerEvent) => {
      const rect = title.getBoundingClientRect()
      title.style.setProperty("--mx", `${event.clientX - rect.left}px`)
      title.style.setProperty("--my", `${event.clientY - rect.top}px`)
    }
    const reset = () => {
      title.style.removeProperty("--mx")
      title.style.removeProperty("--my")
    }
    title.addEventListener("pointermove", update)
    title.addEventListener("pointerleave", reset)
  }
</script>
