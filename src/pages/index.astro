---
import {
  education,
  interests,
  positions,
  profile,
  unattributedStack,
  yearsOfExperience,
} from "../lib/cv"
import { site, social } from "../lib/site"
import Root from "../layouts/Root.astro"

/**
 * The home page is the CV. A visitor who follows the link in the PDF should
 * land on the same information in the same shape: name, tagline, summary,
 * facts, roles. The lattice behind it is brand mood, not the stage.
 */

const years = yearsOfExperience()
---

<Root
  title={site.positioning}
  description={site.description}
  scene="about"
  quiet
>
  <div class="cv shell">
    <header class="cv__head">
      <h1 class="cv__title">{site.name}</h1>
      <p class="cv__tagline">{site.positioning}</p>
      <p class="lead cv__summary">{site.taglineBody}</p>

      <p class="cv__profile">{profile}</p>

      <dl class="cv__facts">
        <div class="cv__fact">
          <dt class="label">Experience</dt>
          <dd>{years} years</dd>
        </div>
        <div class="cv__fact">
          <dt class="label">Now</dt>
          <dd>{positions[0].roles[0].title}, {positions[0].org}</dd>
        </div>
        <div class="cv__fact">
          <dt class="label">Based</dt>
          <dd>{site.location}</dd>
        </div>
        <div class="cv__fact">
          <dt class="label">Contact</dt>
          <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
        </div>
      </dl>
    </header>

    <section class="cv__section" aria-labelledby="cv-experience">
      <h2 class="cv__heading" id="cv-experience">Experience</h2>

      <ol class="roles">
        {
          positions.map((position) => (
            <li class="role">
              <details class="role__box" open>
                <summary class="role__summary">
                  <span class="role__mark" aria-hidden="true" />
                  <span class="role__ident">
                    <span class="role__org">{position.org}</span>
                    <span class="role__meta">
                      {position.location} &middot; {position.span}
                    </span>
                  </span>
                  <span class="role__titles">
                    {position.roles.map((role) => (
                      <span class="role__title">
                        {role.title}
                        <span class="role__title-span">{role.span}</span>
                      </span>
                    ))}
                  </span>
                </summary>

                <div class="role__body">
                  {position.context && (
                    <p class="role__context">{position.context}</p>
                  )}
                  {position.groups.map((group) => (
                    <div class="role__group">
                      {group.heading && (
                        <h4 class="role__group-heading label">
                          {group.heading}
                        </h4>
                      )}
                      <ul class="role__bullets">
                        {group.bullets.map((bullet) => (
                          <li class="role__bullet">{bullet.text}</li>
                        ))}
                      </ul>
                    </div>
                  ))}

                  <div class="role__stack">
                    <h4 class="role__stack-label label">Used here</h4>
                    <ul class="role__stack-items">
                      {position.stack.map((item) => (
                        <li class="skill">{item}</li>
                      ))}
                    </ul>
                  </div>
                </div>
              </details>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="cv__section" aria-labelledby="cv-also">
      <h2 class="cv__heading" id="cv-also">Also works with</h2>
      <p class="cv__plain cv__also-note">
        These are real, but the CV does not tie them to a particular job, so
        they sit here rather than under an employer.
      </p>
      <ul class="skillgroup__items">
        {unattributedStack.map((item) => <li class="skill">{item}</li>)}
      </ul>
    </section>

    <section class="cv__section cv__section--split">
      <div>
        <h2 class="cv__heading" id="cv-education">Education</h2>
        <p class="cv__plain">
          <strong>{education.institution}</strong><br />
          {education.award}<br />
          <span class="cv__span">{education.span}</span>
        </p>
      </div>
      <div>
        <h2 class="cv__heading" id="cv-interests">Interests</h2>
        <p class="cv__plain">{interests}</p>
      </div>
    </section>

    <footer class="cv__foot" id="contact">
      <a class="action action--primary" href={`mailto:${site.email}`}>
        Email me
      </a>
      <a class="action" href="/alex-boffey-cv.pdf" download>Download CV</a>
      <a class="action" href={social.linkedin} rel="me noopener">LinkedIn</a>
      <a class="action" href={social.github} rel="me noopener">GitHub</a>
    </footer>
  </div>
</Root>

<style>
  .cv {
    padding-block: var(--space-2xl) var(--space-3xl);
  }

  .cv__head {
    display: grid;
    gap: var(--space-md);
    max-width: 74ch;
  }

  .cv__title {
    font-size: var(--size-display);
    font-stretch: var(--wdth-display);
    font-weight: 700;
    color: var(--paper);
  }

  .cv__tagline {
    font-size: var(--size-lead);
    color: var(--incandescent);
  }

  .cv__summary {
    max-width: 68ch;
  }

  .cv__profile {
    margin: var(--space-md) 0 0;
    max-width: 74ch;
    color: var(--text-secondary);
  }

  .cv__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: var(--space-md);
    margin: 0;
    padding-block: var(--space-md);
    border-block: 1px solid var(--rule);
  }

  .cv__fact dd {
    margin: 0;
    font-size: var(--size-small);
    color: var(--paper);
  }

  .cv__fact a {
    color: var(--incandescent);
  }

  .cv__section {
    margin-top: var(--space-2xl);
  }

  .cv__section--split {
    display: grid;
    gap: var(--space-xl);
  }

  @media (min-width: 46rem) {
    .cv__section--split {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-2xl);
    }
  }

  .cv__heading {
    padding-bottom: var(--space-sm);
    margin-bottom: var(--space-lg);
    border-bottom: 1px solid var(--rule);
    font-size: var(--size-title);
    font-stretch: 86%;
    color: var(--paper);
  }

  .cv__plain {
    max-width: 54ch;
    color: var(--text-secondary);
  }

  .cv__plain strong {
    color: var(--paper);
    font-weight: 600;
  }

  .cv__span {
    color: var(--text-label);
  }

  .roles {
    display: grid;
    gap: 0;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .role {
    border-bottom: 1px solid var(--rule);
  }

  .role__summary {
    display: grid;
    gap: var(--space-xs) var(--space-lg);
    padding-block: var(--space-lg);
    cursor: pointer;
    list-style: none;
  }

  .role__summary::-webkit-details-marker {
    display: none;
  }

  .role__summary:hover .role__org,
  .role__summary:focus-visible .role__org {
    color: var(--ember);
  }

  .role__mark {
    width: 7px;
    height: 7px;
    border: 1px solid var(--incandescent);
    transform: rotate(45deg);
    transition: transform var(--dur) var(--ease);
  }

  details[open] .role__mark {
    background: var(--incandescent);
    transform: rotate(0deg);
  }

  .role__ident {
    display: grid;
    gap: var(--space-2xs);
  }

  .role__org {
    font-family: var(--font-display);
    font-size: var(--size-row-lg);
    font-stretch: 84%;
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: var(--track-tight);
    color: var(--paper);
    transition: color var(--dur-fast) var(--ease);
  }

  .role__meta {
    font-family: var(--font-display);
    font-size: var(--size-micro);
    font-stretch: 88%;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-label);
  }

  .role__titles {
    display: grid;
    gap: var(--space-2xs);
    align-content: start;
  }

  .role__title {
    display: grid;
    font-size: var(--size-small);
    color: var(--paper);
  }

  .role__title-span {
    font-family: var(--font-display);
    font-size: var(--size-micro);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-label);
  }

  @media (min-width: 52rem) {
    .role__summary {
      grid-template-columns: auto auto minmax(0, 1fr);
      align-items: start;
    }

    .role__mark {
      margin-top: 0.7em;
    }
  }

  .role__body {
    padding-bottom: var(--space-lg);
    max-width: 78ch;
  }

  @media (min-width: 52rem) {
    .role__body {
      padding-left: calc(7px + var(--space-lg));
    }
  }

  .role__context {
    padding-bottom: var(--space-md);
    margin-bottom: var(--space-md);
    border-bottom: 1px solid var(--rule);
    font-size: var(--size-small);
    color: var(--text-label);
  }

  .role__group + .role__group {
    margin-top: var(--space-lg);
  }

  .role__group-heading {
    margin: 0 0 var(--space-sm);
    color: var(--incandescent);
  }

  .role__bullets {
    display: grid;
    gap: var(--space-sm);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .role__bullet {
    position: relative;
    padding-left: var(--space-md);
    color: var(--text-secondary);
  }

  .role__bullet::before {
    content: "";
    position: absolute;
    top: 0.62em;
    left: 0;
    width: 4px;
    height: 4px;
    border: 1px solid var(--glimmer);
    transform: rotate(45deg);
  }

  .role__stack {
    display: grid;
    gap: var(--space-xs);
    padding-top: var(--space-md);
    margin-top: var(--space-md);
    border-top: 1px solid var(--rule);
  }

  .role__stack-label {
    color: var(--text-label);
  }

  .role__stack-items {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-xs);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .cv__also-note {
    margin-bottom: var(--space-md);
    font-size: var(--size-small);
    color: var(--text-label);
  }

  .skillgroup__items {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-xs);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .skill {
    padding: 0.25em 0.55em;
    border: 1px solid var(--rule);
    font-size: var(--size-small);
    color: var(--text-secondary);
  }

  .cv__foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-md);
    padding-top: var(--space-lg);
    margin-top: var(--space-2xl);
    border-top: 1px solid var(--rule);
  }

  @media print {
    .cv__foot {
      display: none;
    }

    .cv {
      padding: 0;
      color: var(--print-base);
    }

    .cv__title,
    .cv__heading,
    .role__org,
    .cv__plain strong,
    .cv__fact dd {
      color: var(--print-ink);
    }

    .cv__summary,
    .role__bullet,
    .cv__plain,
    .skill {
      color: var(--print-text) !important;
      opacity: 1 !important;
    }

    .role__mark,
    .role__bullet::before {
      border-color: var(--print-rule);
      background: none;
    }

    .role {
      break-inside: avoid;
    }

    .skill {
      border-color: var(--print-hairline);
    }
  }
</style>
