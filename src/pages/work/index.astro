---
import EntryList from "../../components/EntryList.astro"
import { type Entry, formatDate, getWork } from "../../lib/entries"
import { site } from "../../lib/site"
import Root from "../../layouts/Root.astro"

const work = await getWork()

const entries: Entry[] = work.map((entry) => ({
  href: `/work/${entry.id}/`,
  title: entry.data.title,
  summary: entry.data.subtitle,
  meta: [formatDate(entry.data.date), ...entry.data.tags.slice(0, 2)],
  placeholder: entry.data.placeholder,
}))
---

<Root
  scene="work"
  title="Work"
  description="Selected projects by Alex Boffey, software engineer in London."
>
  <section class="section shell" aria-labelledby="work">
    <div class="section__head">
      <h1 class="section__title" id="work">Work</h1>
      <p class="section__aside">
        Personal and early-career projects. The commercial work is written up on
        the <a href="/cv/">CV</a> rather than shown here.
      </p>
    </div>

    <EntryList entries={entries} />

    <aside class="gap">
      <h2 class="gap__title">What is not here</h2>
      <p class="gap__body">
        The last few years are production work at <a
          href="https://www.geeiq.com/">GEEIQ</a
        >, where I am {site.role}. I cannot publish screenshots of it, so it is
        written up rather than shown: the React platform rebuild, the design
        system behind it, the testing strategy and the charting layer are all on
        the <a href="/cv/">CV</a>, with the detail intact.
      </p>
      <p class="gap__body">
        If you want to go deeper than a bullet list, <a
          href={`mailto:${site.email}`}>email me</a
        > and I will talk you through it.
      </p>
    </aside>
  </section>
</Root>

<style>
  /* Not a card: a hairline rule and a label, on the page's own ground. The
     placeholder flag leads the block so it governs the claim rather than
     trailing it as a footnote. */
  .gap {
    display: grid;
    gap: var(--space-sm);
    max-width: 64ch;
    margin-top: var(--space-2xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--incandescent);
  }

  .gap__title {
    font-size: var(--size-sub-sm);
    font-stretch: var(--wdth-prose);
    color: var(--paper);
  }

  .gap__body {
    font-size: var(--size-small);
    color: var(--text-secondary);
  }

  .gap__body a {
    color: var(--incandescent);
  }
</style>
