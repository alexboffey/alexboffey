---
import type { GetStaticPaths } from "astro"
import { render } from "astro:content"

import { formatFullDate, getWork } from "../../lib/entries"
import Reading from "../../layouts/Reading.astro"

export const getStaticPaths = (async () => {
  const work = await getWork()
  return work.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }))
}) satisfies GetStaticPaths

const { entry } = Astro.props
const { Content } = await render(entry)

const meta = [formatFullDate(entry.data.date), ...entry.data.tags.slice(0, 4)]
---

<Reading
  title={entry.data.title}
  description={entry.data.subtitle ?? entry.data.title}
  eyebrow="Work"
  meta={meta}
  backHref="/work/"
  backLabel="All work"
>
  <Content />
</Reading>
