---
import Mark from "../components/Mark.astro"
import { site, social } from "../lib/site"
import Root from "../layouts/Root.astro"

const now = new Date()
const stamp = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}-${String(now.getDate()).padStart(2, "0")}-${String(now.getHours()).padStart(2, "0")}${String(now.getMinutes()).padStart(2, "0")}`
const cvDownloadName = `alex-boffey-cv-${stamp}.pdf`

const channels = [
  { href: `mailto:${site.email}`, label: "Email", value: site.email },
  { href: social.linkedin, label: "LinkedIn", value: "in/alexboffey" },
  { href: social.github, label: "GitHub", value: "alexboffey" },
]
---

<Root title="About" description={site.description} quiet scene="about">
  <div class="about shell">
    <header class="about__head">
      <p class="about__name">Alex Boffey</p>
      <h1 class="about__title">
        <span class="about__title-layer about__title-base">
          Product engineer,<br />
          <span class="about__accent">with deep frontend roots</span>
        </span>
        <span class="about__title-layer about__title-swap" aria-hidden="true">
          Product engineer,<br />
          <span class="about__accent-swap">with deep frontend roots</span>
        </span>
      </h1>
      <p class="lead about__lead">
        Hi, Alex here. Some people call me Boff. Software engineer in London,
        nine years in. Also a lifelong musician.
      </p>
    </header>

    <div class="about__grid">
      <section class="about__col prose" aria-labelledby="how">
      <h2 id="how">How I work</h2>
      <p>
        I like the part of the job where an intent meets what the machine will
        actually do, and someone has to decide which one moves. Usually that
        means building the thing properly once so forty features do not each
        solve it badly, whether that thing is a component or a service.
      </p>
      <p>
        Simple, small, contained, easy to change beats complex and
        over-engineered every time. Code that does one thing is easy to change;
        code that does seven is not. Most of the complexity in a codebase is
        accidental, piled on by poor interfaces and things that should have
        stayed separate. The payoff for cutting it lands on three sides at
        once: a simple system is easier to run, easier to change next month,
        and the two feed each other. A system you can see into tells you what
        needs to move; a system you can move keeps giving you useful signals
        as it does.
      </p>
      <p>
        The e2e tests worth having drive the full system the way a real user
        would. Happy-path assertions are easy to write and often add little. A
        green suite can be entirely consistent with a broken feature.
      </p>

      <h2>Music &amp; audio</h2>
      <p>
        Lifelong guitar player, mostly electric and I love effects, with some
        classical on the side. I play in a band and own the technical side:
        demos, sound design, synthesis, sampling, and the live rig. The parts
        that need an audio engineer get one. I collaborate rather than fake it.
      </p>
      <p>
        The live rig is hardware that takes production tracks and breaks them
        down into something the band can play against: stems, playable effects,
        a cue system that runs the show. The two worlds inform each other,
        mostly in one direction: software habits travel into the music tech.
        Don't trust it until it is tested. Use compute efficiently. Keep it
        simple.
      </p>
      </section>

      <aside class="about__side" id="contact" aria-labelledby="contact-h">
      <a
        class="about__contact-head"
        href={`mailto:${site.email}`}
        aria-label="Email Alex"
      >
        <Mark size={28} />
        <h2 class="about__contact-title" id="contact-h">Get in touch</h2>
      </a>
      <p class="about__contact-body">
        If you are hiring, or you want to argue about design tokens, email is
        the fastest way to reach me.
      </p>

      <dl class="channels">
        {
          channels.map((channel) => (
            <div class="channel">
              <dt class="channel__label">{channel.label}</dt>
              <dd class="channel__value">
                <a
                  href={channel.href}
                  rel={
                    channel.href.startsWith("http") ? "me noopener" : undefined
                  }
                >
                  {channel.value}
                </a>
              </dd>
            </div>
          ))
        }
      </dl>

      <div class="about__ctas">
        <a class="action action--primary" href={`mailto:${site.email}`}>
          Email me
        </a>
        <a class="action" href="/alex-boffey-cv.pdf" download={cvDownloadName}>
          Download CV
        </a>
      </div>
      </aside>
    </div>
  </div>
</Root>

<style>
  .about {
    padding-block: var(--space-2xl) var(--space-3xl);
  }

  .about__head {
    display: grid;
    gap: var(--space-md);
  }

  .about__title {
    position: relative;
    font-size: var(--size-display);
    font-stretch: var(--wdth-display);
    font-weight: 700;
    line-height: 0.96;
    color: var(--paper);
    transition:
      font-stretch 900ms var(--ease),
      opacity 600ms var(--ease);
  }

  .about__title-layer {
    display: block;
  }

  .about__title-swap {
    position: absolute;
    inset: 0;
    color: var(--incandescent);
    pointer-events: none;
    --mask-size: 320px;
    -webkit-mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 750 750'><polygon points='487.1,576.7 263.7,706.5 38.9,576.7 262.3,446.9' fill='black'/><polygon points='488.5,309.9 487.7,568.2 262.9,438.4 263.7,180.1' fill='black'/><polygon points='254.3,183.3 255,441.6 30.2,571.4 29.5,313.1' fill='black'/><polygon points='715.8,173.3 492.4,303.1 267.6,173.3 491,43.5' fill='black'/><polygon points='719.8,180.1 720.5,438.4 495.7,568.2 495,309.9' fill='black'/></svg>");
    mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 750 750'><polygon points='487.1,576.7 263.7,706.5 38.9,576.7 262.3,446.9' fill='black'/><polygon points='488.5,309.9 487.7,568.2 262.9,438.4 263.7,180.1' fill='black'/><polygon points='254.3,183.3 255,441.6 30.2,571.4 29.5,313.1' fill='black'/><polygon points='715.8,173.3 492.4,303.1 267.6,173.3 491,43.5' fill='black'/><polygon points='719.8,180.1 720.5,438.4 495.7,568.2 495,309.9' fill='black'/></svg>");
    -webkit-mask-size: var(--mask-size) var(--mask-size);
    mask-size: var(--mask-size) var(--mask-size);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: calc(var(--mx, -600px) - var(--mask-size) / 2)
      calc(var(--my, -600px) - var(--mask-size) / 2);
    mask-position: calc(var(--mx, -600px) - var(--mask-size) / 2)
      calc(var(--my, -600px) - var(--mask-size) / 2);
  }

  .about__accent-swap {
    color: var(--paper);
  }

  @media (prefers-reduced-motion: reduce) {
    .about__title-swap {
      display: none;
    }
  }

  @starting-style {
    .about__title {
      font-stretch: 62%;
      opacity: 0;
    }
  }

  .about__title:hover {
    animation: title-breathe 3s ease-in-out infinite;
  }

  @keyframes title-breathe {
    0%,
    100% {
      font-stretch: var(--wdth-display);
    }
    50% {
      font-stretch: 94%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about__title {
      transition: none;
      animation: none;
    }
    .about__title:hover {
      animation: none;
    }
  }

  .about__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--size-label);
    font-stretch: 88%;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-label);
  }

  .about__accent {
    color: var(--incandescent);
  }

  .about__lead {
    max-width: 54ch;
  }

  .about__lead a {
    color: var(--incandescent);
  }

  .about__grid {
    display: grid;
    gap: var(--space-2xl);
    margin-top: var(--space-xl);
  }

  @media (min-width: 62rem) {
    .about__grid {
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 24rem);
      gap: var(--space-3xl);
      align-items: start;
    }

    .about__side {
      position: sticky;
      top: var(--space-lg);
    }
  }

  .about__col {
    max-width: 68ch;
  }

  .about__side {
    display: grid;
    gap: var(--space-md);
  }

  .about__contact-head {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    text-decoration: none;
    color: inherit;
    width: fit-content;
    --mark-dur: 700ms;
  }

  .about__contact-title {
    margin: 0;
    font-size: var(--size-sub);
    font-stretch: var(--wdth-title);
    color: var(--paper);
    transition: color var(--dur-fast) var(--ease);
  }

  .about__contact-head:hover .about__contact-title,
  .about__contact-head:focus-visible .about__contact-title {
    color: var(--incandescent);
  }

  .about__contact-body {
    margin: 0;
    font-size: var(--size-small);
    color: var(--text-secondary);
  }

  .channels {
    display: grid;
    gap: 0;
    margin: 0;
    border-top: 1px solid var(--rule);
  }

  .channel {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    padding-block: var(--space-sm);
    border-bottom: 1px solid var(--rule);
  }

  .channel__label {
    font-family: var(--font-display);
    font-size: var(--size-micro);
    font-stretch: 88%;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-label);
  }

  .channel__value {
    margin: 0;
    font-size: var(--size-small);
    text-align: right;
  }

  .channel__value a {
    text-decoration: none;
    color: var(--paper);
  }

  .channel__value a:hover,
  .channel__value a:focus-visible {
    color: var(--incandescent);
  }

  .about__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-sm);
  }
</style>

<script>
  // Cursor-follow colour swap on the About hero. Two layered copies of the
  // title: the base layer is normal, the swap layer sits on top with the two
  // colours inverted and a circular mask around the pointer. --mx and --my
  // start off-canvas so the mask reveals nothing until the pointer enters.
  const title = document.querySelector<HTMLElement>(".about__title")
  if (title && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const update = (event: PointerEvent) => {
      const rect = title.getBoundingClientRect()
      title.style.setProperty("--mx", `${event.clientX - rect.left}px`)
      title.style.setProperty("--my", `${event.clientY - rect.top}px`)
    }
    const reset = () => {
      title.style.removeProperty("--mx")
      title.style.removeProperty("--my")
    }
    title.addEventListener("pointermove", update)
    title.addEventListener("pointerleave", reset)
  }
</script>
