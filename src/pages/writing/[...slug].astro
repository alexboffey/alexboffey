---
import type { GetStaticPaths } from "astro"
import { render } from "astro:content"

import { formatFullDate, getWriting, readingTime } from "../../lib/entries"
import Reading from "../../layouts/Reading.astro"

export const getStaticPaths = (async () => {
  const writing = await getWriting()
  return writing.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }))
}) satisfies GetStaticPaths

const { entry } = Astro.props
const { Content } = await render(entry)

const meta = [
  formatFullDate(entry.data.date),
  `${readingTime(entry.body)} min read`,
  ...entry.data.tags.slice(0, 3),
]
---

<Reading
  title={entry.data.title}
  description={entry.data.subtitle ?? entry.data.title}
  eyebrow="Writing"
  meta={meta}
  backHref="/writing/"
  backLabel="All writing"
>
  <Content />
</Reading>
