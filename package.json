{
  "name": "alexboffey",
  "description": "Alex Boffey personal site",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "npm run lint:prettier && npm run lint:astro",
    "lint:prettier": "prettier --check \"**/*.{astro,ts,js,css,md,json}\"",
    "lint:astro": "astro check",
    "fix": "prettier --write \"**/*.{astro,ts,js,css,md,json}\"",
    "test": "playwright test",
    "test:ui": "playwright test --ui"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.0",
    "astro": "^7.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@fontsource-variable/anybody": "^5.3.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "sirv-cli": "^3.0.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.120.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
